##
## sites-enabled/default — Virtual server principal
## Portal Cautivo: autenticación PAP con rlm_sql/PostgreSQL
##

server default {
    listen {
        type      = auth
        ipaddr    = *
        port      = 1812
        limit {
            max_connections = 16
            lifetime        = 0
            idle_timeout    = 30
        }
    }

    listen {
        type      = acct
        ipaddr    = *
        port      = 1813
        limit {}
    }

    # ── Sección authorize ─────────────────────────────────────────────────────
    # Se ejecuta para cada Access-Request recibido.
    # Busca el usuario en radcheck vía SQL y establece Auth-Type.
    authorize {
        # Resolver primero usuarios locales. Esto evita que una caída de LDAP
        # bloquee el portal cautivo y los usuarios WPA locales.
        sql

        # LDAP solo se consulta si no hay credenciales locales y no es la
        # solicitud EAP exterior. La identidad EAP se resuelve en inner-tunnel.
        if (!control:Cleartext-Password && !control:NT-Password && !request:EAP-Message) {
            ldap
        }

        # Validar fecha de expiración del usuario si el atributo Expiration está en radcheck
        expiration

        # Si el usuario tiene Cleartext-Password en radcheck, usar PAP
        pap

        # Procesar solicitudes EAP (802.1X WPA-Enterprise)
        eap
    }

    # ── Sección authenticate ──────────────────────────────────────────────────
    # Autenticación efectiva según Auth-Type detectado en authorize.
    authenticate {
        Auth-Type PAP {
            pap
        }

        # Autenticación contra LDAP
        Auth-Type LDAP {
            ldap
        }

        # Procesar EAP
        eap
    }

    # ── Pre-Accounting ────────────────────────────────────────────────────────
    # Genera el identificador único de sesión (Acct-Unique-Session-Id)
    preacct {
        preprocess
        acct_unique
    }

    # ── Accounting ────────────────────────────────────────────────────────────
    accounting {
        sql
    }

    # ── Session ───────────────────────────────────────────────────────────────
    session {
        sql
    }

    # ── Post-Auth ─────────────────────────────────────────────────────────────
    post-auth {
        # Registrar en radpostauth si existe la tabla
        # sql

        # Asignar VLAN: prioridad a VLAN individual (radreply) sobre VLAN por grupo LDAP.
        # Cargar directamente desde radreply por si el módulo sql no lo hizo en authorize.
        if (!&reply:Tunnel-Private-Group-ID) {
            # 1. Intentar VLAN individual desde radreply
            if ("%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Tunnel-Private-Group-ID' LIMIT 1}") {
                update reply {
                    Tunnel-Type := VLAN
                    Tunnel-Medium-Type := IEEE-802
                    Tunnel-Private-Group-ID := "%{sql:SELECT value FROM radreply WHERE username = '%{User-Name}' AND attribute = 'Tunnel-Private-Group-ID' LIMIT 1}"
                }
            }
            # 2. Si no hay VLAN individual, buscar VLAN por grupo LDAP
            elsif (control:Auth-Type == LDAP) {
                foreach &control:LDAP-Group {
                    if ("%{sql:SELECT vlan_id FROM ldap_group_vlans WHERE LOWER(group_dn) = LOWER('%{Foreach-Variable-0}') LIMIT 1}") {
                        update reply {
                            Tunnel-Type := VLAN
                            Tunnel-Medium-Type := IEEE-802
                            Tunnel-Private-Group-ID := "%{sql:SELECT vlan_id FROM ldap_group_vlans WHERE LOWER(group_dn) = LOWER('%{Foreach-Variable-0}') LIMIT 1}"
                        }
                        break
                    }
                }
            }
        }

        Post-Auth-Type REJECT {
            attr_filter.access_reject
        }
    }

    # ── Pre-Proxy / Post-Proxy ────────────────────────────────────────────────
    pre-proxy {}
    post-proxy {}
}
