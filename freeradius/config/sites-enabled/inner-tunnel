##
## sites-enabled/inner-tunnel — Servidor virtual para túneles internos (EAP-PEAP / EAP-TTLS)
##

server inner-tunnel {
    # ── Sección authorize ──
    # Se ejecuta dentro del túnel TLS seguro.
    authorize {
        filter_username
        chap
        mschap

        # Procesar la negociación EAP antes de buscar credenciales.
        eap {
            ok = return
        }

        # Usuarios locales primero; LDAP queda como fallback para WPA.
        sql
        if (!control:Cleartext-Password && !control:NT-Password) {
            ldap
            if (ok || updated) {
                update control {
                    Auth-Type := LDAP
                }
            }
        }

        # Validar fecha de expiración si el atributo Expiration está en radcheck
        expiration
        pap
    }

    # ── Sección authenticate ──
    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
        Auth-Type LDAP {
            ldap
        }
        eap
    }

    # ── Sección post-auth ──
    post-auth {
        # Asignar dinámicamente VLAN para usuarios LDAP según grupo AD
        if (control:Auth-Type == LDAP) {
            foreach &control:LDAP-Group {
                if ("%{sql:SELECT vlan_id FROM ldap_group_vlans WHERE LOWER(group_dn) = LOWER('%{Foreach-Variable-0}') LIMIT 1}") {
                    update reply {
                        Tunnel-Type := VLAN
                        Tunnel-Medium-Type := IEEE-802
                        Tunnel-Private-Group-ID := "%{sql:SELECT vlan_id FROM ldap_group_vlans WHERE LOWER(group_dn) = LOWER('%{Foreach-Variable-0}') LIMIT 1}"
                    }
                    break
                }
            }
        }

        # Mapear estado de sesión si corresponde
        update {
            &reply: += &session-state:
        }
    }
}
