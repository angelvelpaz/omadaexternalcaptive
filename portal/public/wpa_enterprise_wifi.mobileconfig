<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>EncryptionType</key>
			<string>WPA2</string>
			<key>PayloadDescription</key>
			<string>Configura los ajustes de la red inalámbrica segura WPA-Enterprise</string>
			<key>PayloadDisplayName</key>
			<string>Wi-Fi WPA Enterprise</string>
			<key>PayloadIdentifier</key>
			<string>com.captiveportal.wifi.wpa2enterprise</string>
			<key>PayloadType</key>
			<string>com.apple.wifi.managed</string>
			<key>PayloadUUID</key>
			<string>33C8B7AA-BD8C-4C67-AF2B-2A0D8D44A68F</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>SSID_STR</key>
			<string>EAPENT</string>
			<key>EAPClientConfiguration</key>
			<dict>
				<key>AcceptEAPTypes</key>
				<array>
					<integer>21</integer> <!-- 21 corresponde a EAP-TTLS -->
				</array>
				<key>TTLSInnerAuthentication</key>
				<string>PAP</string>
			</dict>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Perfil para la conexión automática a la red WPA Enterprise (EAP-TTLS + PAP)</string>
	<key>PayloadDisplayName</key>
	<string>Configuracion Wi-Fi Corporativa (EAPENT)</string>
	<key>PayloadIdentifier</key>
	<string>com.captiveportal.wifi.profile</string>
	<key>PayloadOrganization</key>
	<string>Gobierno Provincial de Pichincha</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>55E38C45-A2BF-4C6E-90B1-5D3FA61A4E9E</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
