##
## sites-enabled/inner-tunnel — Servidor virtual para túneles internos (EAP-PEAP / EAP-TTLS)
##

server inner-tunnel {
    # ── Sección authorize ──
    # Se ejecuta dentro del túnel TLS seguro.
    authorize {
        filter_username
        chap
        mschap

        # Procesar la negociación EAP antes de buscar credenciales.
        eap {
            ok = return
        }

        # Usuarios locales primero; LDAP queda como fallback para TTLS/PAP.
        sql

        # Para PEAP/MSCHAPv2, esperar a que el paquete interno contenga el
        # desafío y la respuesta antes de consultar grupos LDAP y delegar la
        # contraseña a Winbind.
        if (request:MS-CHAP-Challenge && request:MS-CHAP2-Response) {
            if (!control:Cleartext-Password && !control:NT-Password) {
                ldap
            }
            update control {
                Auth-Type := MS-CHAP
            }
        }
        else {
            if (!request:EAP-Message && !control:Cleartext-Password && !control:NT-Password) {
                ldap
                if (ok || updated) {
                    update control {
                        Auth-Type := LDAP
                    }
                }
            }
        }

        # Validar fecha de expiración si el atributo Expiration está en radcheck
        expiration
        pap
    }

    # ── Sección authenticate ──
    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
        Auth-Type LDAP {
            ldap
        }
        eap
    }

    # ── Sección post-auth ──
    post-auth {
        # Cargar VLAN individual desde radreply (authorize_reply_query no se ejecuta en inner-tunnel PEAP)
        # Primero intentar individuo, luego grupo AD
        if (!&reply:Tunnel-Private-Group-ID) {
            # 1. Intentar VLAN individual desde radreply
            if ("%{sql:SELECT value FROM radreply WHERE LOWER(username) = LOWER('%{User-Name}') AND attribute = 'Tunnel-Private-Group-ID' LIMIT 1}") {
                update reply {
                    Tunnel-Type := VLAN
                    Tunnel-Medium-Type := IEEE-802
                    Tunnel-Private-Group-ID := "%{sql:SELECT value FROM radreply WHERE LOWER(username) = LOWER('%{User-Name}') AND attribute = 'Tunnel-Private-Group-ID' LIMIT 1}"
                }
            }
            # 2. Si no hay VLAN individual, buscar VLAN por grupo LDAP
            elsif (&control:LDAP-Group) {
                foreach &control:LDAP-Group {
                    if ("%{sql:SELECT vlan_id FROM ldap_group_vlans WHERE LOWER(group_dn) = LOWER('%{Foreach-Variable-0}') LIMIT 1}") {
                        update reply {
                            Tunnel-Type := VLAN
                            Tunnel-Medium-Type := IEEE-802
                            Tunnel-Private-Group-ID := "%{sql:SELECT vlan_id FROM ldap_group_vlans WHERE LOWER(group_dn) = LOWER('%{Foreach-Variable-0}') LIMIT 1}"
                        }
                        break
                    }
                }
            }
        }

        # Mapear estado de sesión si corresponde
        update {
            &reply: += &session-state:
        }
    }
}
